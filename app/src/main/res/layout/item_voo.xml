<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Cartao"
    android:orientation="vertical">

    <!-- Linha 1: número | estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNumero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TP1940"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEstado"
            style="@style/Etiqueta"
            android:text="agendado" />
    </LinearLayout>

    <!-- Linha 2: hora partida | hora chegada -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPartida"
            style="@style/HoraGrande"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="08:00" />

        <TextView
            android:id="@+id/tvChegada"
            style="@style/HoraGrande"
            android:text="09:00" />
    </LinearLayout>

    <!-- Linha 3: rota | preço -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRota"
            style="@style/TextoPequeno"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="LIS → OPO" />

        <TextView
            android:id="@+id/tvPreco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="49,99 €"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>